{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dcollette4456.github.io/schema/manifest-1.json",
  "title": "Evidence manifest, schema version 1",
  "description": "CLAUDECODEBRIEF §7.2, informed by classification spec §14 (evidence retention tiers) and §23 (format families). One file per issue, listing every source cited and what was fetched/attested for it. Attestation (hash, timestamp) is always attempted; preservation (an archive copy) is attempted but its failure never blocks the entry.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "serial", "generated", "entries", "manifest_sha256"],
  "properties": {
    "schema_version": { "const": 1 },
    "serial": { "type": "string", "pattern": "^(TI|IW)-(RETRO-[0-9]{3}|[0-9]{8}-[0-9]{3})$" },
    "generated": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$" },
    "capture_is_retrospective": {
      "type": "boolean",
      "description": "true where fetched is today's date rather than the issue's original publication date. CLAUDECODEBRIEF §9."
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "ref", "url", "format_family", "preservation"],
        "properties": {
          "source_id": { "type": "string", "pattern": "^SRC-[0-9]{4,}$" },
          "ref": { "type": "string", "pattern": "^REF-[0-9A-Za-z-]+$" },
          "url": { "type": "string", "pattern": "^https?://" },
          "format_family": {
            "type": "string",
            "enum": ["html", "pdf", "media", "repository", "feed", "query", "social"]
          },
          "fetched": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$" },
          "http_status": { "type": "integer" },
          "content_type": { "type": ["string", "null"], "minLength": 1, "description": "null where the response carried no Content-Type header at all -- a legitimate absence, not an empty string." },
          "content_length": { "type": "integer", "minimum": 0 },
          "sha256_raw": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "sha256_normalized": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "normalizer": { "type": "string", "minLength": 1 },
          "extractor": { "type": ["string", "null"] },
          "version_identity": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["normalized_hash", "text_hash", "transcript_hash", "commit_sha", "record_hash", "query_execution", "content_hash"]
              },
              "value": { "type": "string" }
            }
          },
          "archive": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status"],
            "properties": {
              "status": { "type": "string", "enum": ["captured", "failed", "blocked", "not_attempted", "unavailable"] },
              "provider": { "type": "string" },
              "url": { "type": "string" },
              "attempted": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$" },
              "note": { "type": "string", "description": "Why a non-captured attempt failed: a timeout, an HTTP error, a rate limit. capture_evidence.py records this on every failed/blocked attempt." }
            }
          },
          "preservation": {
            "type": "string",
            "enum": ["archive_only", "self_hosted", "none"]
          },
          "notes": { "type": ["string", "null"] }
        }
      }
    },
    "manifest_sha256": {
      "type": "string",
      "description": "sha256 of this file's own entries array, computed over a canonical serialization, excluding this field itself. Printed in the issue footer as the snapshot-in-time attestation.",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "object",
      "description": "RFC 3161 / OpenTimestamps anchor on manifest_sha256. Hook only for now, per CLAUDECODEBRIEF appendix; not populated in this pass.",
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "enum": ["not_yet_anchored", "anchored"] },
        "provider": { "type": "string" },
        "proof": { "type": "string" },
        "anchored": { "type": "string" }
      }
    }
  }
}

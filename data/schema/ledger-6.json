{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dcollette4456.github.io/schema/ledger-6.json",
  "title": "Claim ledger, schema version 6",
  "description": "Classification spec §15 and §24. One JSON file per issue: /data/ledger/{serial}.json, an array of claim objects matching this schema. v6 (classification spec v4.2 amendments) adds: the gate_evaluation conditions block (§15, §30 stage 4), required on every entry; time.publication_model and an optional (nullable) time.source_published, for a continuously-updated record with no single publication event (§26); provenance.window and provenance.capture_is_retrospective stay optional issue-context fields, now explicitly the responsibility of the ledger writer rather than a grading call (§15A). Earlier: v5 added single_pass to grader.agreement and superseding to volatility.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": true,
    "required": [
      "claim_id",
      "fingerprint",
      "issue",
      "first_issue",
      "citation_count",
      "text",
      "source_id",
      "source_type",
      "grade",
      "relay_depth",
      "evidentiary_status",
      "polarity",
      "volatility",
      "language",
      "synthetic",
      "gates",
      "gate_vector",
      "segmentation",
      "grader",
      "hunt_value",
      "sectors",
      "actors",
      "assertion_license",
      "entities",
      "time",
      "provenance",
      "disposition",
      "gate_evaluation"
    ],
    "properties": {
      "claim_id": {
        "type": "string",
        "pattern": "^(TI|IW)-(RETRO-[0-9]{3}|[0-9]{8}-[0-9]{3})-C[0-9]+$"
      },
      "fingerprint": {
        "type": "string",
        "minLength": 1,
        "description": "source_id | document_sha256_normalized | gate_vector. Classification spec §2."
      },
      "issue": {
        "type": "string",
        "minLength": 1
      },
      "first_issue": {
        "type": "string",
        "minLength": 1
      },
      "citation_count": {
        "type": "integer",
        "minimum": 1
      },
      "text": {
        "type": "string",
        "minLength": 1,
        "description": "No prose from the source. Classification spec §14."
      },
      "source_id": {
        "type": "string",
        "pattern": "^SRC-[0-9]{4,}$"
      },
      "source_type": {
        "type": "string",
        "enum": [
          "GOV",
          "VND",
          "MED",
          "ACA",
          "TEC",
          "IND",
          "NPO",
          "AGG",
          "SOC",
          "ADV",
          "ANL"
        ]
      },
      "grade": {
        "type": "integer",
        "minimum": 1,
        "maximum": 6
      },
      "access": {
        "type": [
          "string",
          "null"
        ],
        "enum": [
          "open",
          "gated",
          "restricted",
          "withdrawn",
          "unarchived",
          "retracted",
          "retrieval_failed",
          null
        ]
      },
      "relay_depth": {
        "type": [
          "integer",
          "string"
        ],
        "description": "0, 1, 2+ as an integer, or the literal string 'unresolved'. Classification spec §5."
      },
      "origin_named": {
        "type": [
          "string",
          "null"
        ]
      },
      "evidentiary_status": {
        "type": "string",
        "enum": [
          "observed",
          "alleged",
          "adjudicated",
          "self_reported"
        ]
      },
      "polarity": {
        "type": "string",
        "enum": [
          "positive",
          "negative"
        ]
      },
      "volatility": {
        "type": "string",
        "enum": [
          "durable",
          "perishable",
          "superseding"
        ]
      },
      "language": {
        "type": "string",
        "pattern": "^[a-z]{2}$"
      },
      "translation": {
        "type": "string",
        "enum": [
          "none",
          "published",
          "machine"
        ]
      },
      "synthetic": {
        "type": "boolean"
      },
      "superseded_by": {
        "type": [
          "string",
          "null"
        ]
      },
      "disputed": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": false,
        "properties": {
          "vectors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "published_grade": {
            "type": "integer"
          },
          "basis": {
            "type": "string"
          },
          "queued": {
            "type": "string"
          }
        }
      },
      "contested": {
        "type": [
          "string",
          "null"
        ]
      },
      "attribution_contested": {
        "type": [
          "string",
          "null"
        ]
      },
      "gates": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "retrievable",
          "origin_stated",
          "direct_observation",
          "aggregate",
          "artifact_test",
          "method_test",
          "hedge_test"
        ],
        "properties": {
          "retrievable": {
            "type": "boolean"
          },
          "origin_stated": {
            "type": "boolean"
          },
          "direct_observation": {
            "type": "boolean"
          },
          "aggregate": {
            "type": "boolean"
          },
          "artifact_test": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "n/a"
            ]
          },
          "method_test": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "n/a"
            ]
          },
          "hedge_test": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "n/a"
            ]
          }
        }
      },
      "gate_vector": {
        "type": "string",
        "minLength": 1
      },
      "segmentation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "atomic_assertions",
          "merged",
          "assertions"
        ],
        "properties": {
          "atomic_assertions": {
            "type": "integer",
            "minimum": 1
          },
          "merged": {
            "type": "boolean"
          },
          "merge_basis": {
            "type": "string"
          },
          "assertions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "descriptor"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^A[0-9]+$"
                },
                "descriptor": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      },
      "grader": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "model",
          "spec_version",
          "schema_version",
          "normalizer",
          "run",
          "passes",
          "agreement"
        ],
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1
          },
          "spec_version": {
            "type": "string",
            "minLength": 1
          },
          "schema_version": {
            "const": 6
          },
          "normalizer": {
            "type": "string",
            "minLength": 1
          },
          "run": {
            "type": "string"
          },
          "passes": {
            "type": "integer",
            "minimum": 1
          },
          "agreement": {
            "type": "string",
            "enum": [
              "unanimous",
              "majority",
              "split",
              "single_pass"
            ]
          },
          "dissent": {
            "type": [
              "string",
              "null"
            ]
          },
          "reconciliation": {
            "type": "string",
            "enum": [
              "pass",
              "fail"
            ]
          },
          "reconciliation_passes": {
            "type": "integer"
          },
          "reconciliation_dissent": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "hunt_value": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "behavioral",
          "huntable",
          "indicator_bearing"
        ],
        "properties": {
          "behavioral": {
            "type": "boolean"
          },
          "behavioral_basis": {
            "type": "string"
          },
          "huntable": {
            "type": "boolean"
          },
          "telemetry_classes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "collection_point_basis": {
            "type": "string",
            "enum": [
              "stated",
              "derived"
            ]
          },
          "collection_point_source": {
            "type": "string"
          },
          "technique_ids": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "basis"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "basis": {
                  "type": "string",
                  "enum": [
                    "transcribed",
                    "derived"
                  ]
                }
              }
            }
          },
          "indicator_bearing": {
            "type": "boolean"
          }
        }
      },
      "corroboration": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": false,
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "basis": {
            "type": "string"
          },
          "alias_resolved": {
            "type": "boolean"
          }
        }
      },
      "sectors": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "confirmed",
          "contextual"
        ],
        "properties": {
          "confirmed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "contextual": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "justified_by": {
            "type": "string"
          }
        }
      },
      "actors": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subject",
          "referenced"
        ],
        "properties": {
          "subject": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "referenced": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "names_used_by_source": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "equivalences_stated": {
            "type": "array"
          },
          "justified_by": {
            "type": "string"
          }
        }
      },
      "assertion_license": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "may_assert",
          "may_present_as_fact",
          "may_ground_recommendation"
        ],
        "properties": {
          "may_assert": {
            "type": "string",
            "minLength": 1
          },
          "attribution_required": {
            "type": "boolean"
          },
          "required_form": {
            "type": "string"
          },
          "may_present_as_fact": {
            "type": "boolean"
          },
          "may_ground_recommendation": {
            "type": "boolean"
          },
          "expires": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "override": {
        "type": [
          "object",
          "null"
        ]
      },
      "entities": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "clusters",
          "families",
          "tools",
          "campaigns",
          "vulnerabilities"
        ],
        "properties": {
          "clusters": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "families": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "campaigns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "vulnerabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "justified_by": {
            "type": "string"
          }
        }
      },
      "time": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fetched"
        ],
        "properties": {
          "observed_period": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "start": {
                "type": "string"
              },
              "end": {
                "type": "string"
              },
              "basis": {
                "type": "string",
                "enum": [
                  "stated",
                  "derived"
                ]
              },
              "precision": {
                "type": "string",
                "enum": [
                  "day",
                  "month",
                  "year"
                ]
              }
            }
          },
          "source_published": {
            "type": [
              "string",
              "null"
            ]
          },
          "fetched": {
            "type": "string"
          },
          "lag_days": {
            "type": "integer"
          },
          "publication_model": {
            "type": "string",
            "enum": [
              "dated",
              "continuous"
            ],
            "description": "dated is the default and need not be printed. continuous means the source is a live, continuously-updated record with no single publication event (a catalog entry, a certificate log, a live advisory status page) -- source_published is null in that case, per classification spec §26, rather than a fabricated date."
          }
        }
      },
      "provenance": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pool"
        ],
        "properties": {
          "pool": {
            "type": "string",
            "enum": [
              "live",
              "backfill",
              "corroborating"
            ]
          },
          "source_published": {
            "type": "string"
          },
          "window": {
            "type": "string"
          },
          "capture_is_retrospective": {
            "type": "boolean"
          }
        }
      },
      "fetch": {
        "type": "object",
        "description": "Tier 1 fetch record. Classification spec §14."
      },
      "extracted": {
        "type": "object",
        "description": "Tier 2 extracted facts. Classification spec §14. No source prose except title/byline/published."
      },
      "archive": {
        "type": "object",
        "description": "Tier 3 archive pointer. Classification spec §14."
      },
      "disposition": {
        "type": "string"
      },
      "schema_version": {
        "const": 6
      },
      "gate_evaluation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "isolation",
          "sources_in_context",
          "assertions_graded_in_this_call",
          "topic_framing_present",
          "specification_version_read"
        ],
        "description": "Classification spec §15, §30 stage 4. The conditions under which this claim gate-evaluated, recorded rather than asserted. validate_data.py checks sources_in_context holds exactly one entry whenever isolation reads single_source_single_claim.",
        "properties": {
          "isolation": {
            "type": "string",
            "enum": [
              "single_source_single_claim",
              "multi_source_context",
              "undisclosed"
            ]
          },
          "sources_in_context": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "assertions_graded_in_this_call": {
            "type": "integer",
            "minimum": 1
          },
          "topic_framing_present": {
            "type": "boolean",
            "description": "Whether the prompt text handed to the grader characterized what the source concluded, rather than only naming which assertion to look at. Not a contamination flag -- it reports a fact about the prompt, not a judgment about the grader's own reasoning."
          },
          "specification_version_read": {
            "type": "string"
          },
          "prompt_version": {
            "type": "string"
          }
        }
      }
    }
  }
}
